object MainForm: TMainForm
  Left = 200
  Height = 640
  Top = 60
  Width = 1080
  AllowDropFiles = True
  Caption = 'LogChart'
  ClientHeight = 620
  ClientWidth = 1080
  Constraints.MinHeight = 400
  Constraints.MinWidth = 700
  Menu = MainMenu1
  Position = poScreenCenter
  OnClose = FormClose
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  OnDropFiles = FormDropFiles
  OnShow = FormShow
  object StatusBar1: TStatusBar
    Left = 0
    Height = 23
    Top = 597
    Width = 1080
    Panels = <
      item
        Width = 330
      end
      item
        Width = 360
      end
      item
        Width = 50
      end>
    SimplePanel = False
  end

  end
  object LabelFile: TLabel
    Left = 84
    Height = 15
    Top = 34
    Width = 302
    AutoSize = False
    Caption = '-'
    Font.Color = clGrayText
    ParentFont = False
  end
  object Bar: TProgressBar
    Left = 84
    Height = 16
    Top = 56
    Width = 302
    Max = 1000

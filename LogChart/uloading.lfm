object LoadingForm: TLoadingForm
  Left = 400
  Height = 150
  Top = 300
  Width = 400
  BorderIcons = []
  BorderStyle = bsToolWindow
  Caption = 'Loading'
  ClientHeight = 150
  ClientWidth = 400
  FormStyle = fsStayOnTop
  Position = poOwnerFormCenter
